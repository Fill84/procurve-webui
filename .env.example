# Required — the switch must be reachable from the container
SWITCH_HOST=192.0.2.3
SWITCH_PORT=80

# Where docker-compose publishes the web UI on the host (NOT the switch port).
# Defaults shown; WEBUI_BIND=0.0.0.0 exposes the UI to the whole LAN.
# WEBUI_PORT=8080
# WEBUI_BIND=127.0.0.1

# Required — generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional — default values shown
READ_ONLY=true
SESSION_TTL_HOURS=8
POLL_INTERVAL_SECONDS=2.0
# BACKUPS_DIR=/app/backups
# FRONTEND_DIST=/app/frontend/dist
# HOST=0.0.0.0        # bind address INSIDE the container (leave as-is for Docker)
# PORT=8080           # port INSIDE the container (healthcheck follows it)
# METRICS_ENABLED=false  # reserved: /metrics endpoint is not implemented yet
