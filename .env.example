# Required — the switch must be reachable from the container
SWITCH_HOST=192.0.2.3
SWITCH_PORT=80

# Required — generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional — default values shown
READ_ONLY=true
SESSION_TTL_HOURS=8
POLL_INTERVAL_SECONDS=2.0
# BACKUPS_DIR=/app/backups
# FRONTEND_DIST=/app/frontend/dist
