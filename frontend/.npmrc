# openapi-typescript@7 declares peer typescript@^5.x, but the Vite react-ts
# template scaffolds with typescript@6. openapi-typescript is a dev-only code
# generator (it emits .ts files and never runs against app code), so the peer
# conflict is cosmetic. Opt into legacy peer resolution so CI installs stay
# reproducible without requiring --legacy-peer-deps on every command.
legacy-peer-deps=true
